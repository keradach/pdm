# ==========================================================================
# PDM - Caddy reverse proxy (HTTPS termination)
# Caddy auto-provisions & renews Let's Encrypt certificates.
# Ports 80/443 are served by Caddy, then proxied to internal containers.
# ==========================================================================

pdmrc.doae.go.th {
    encode gzip

    # Laravel API -> backend nginx container
    handle /api/* {
        reverse_proxy backend-nginx:80
    }

    # Vue static frontend -> frontend nginx container
    handle {
        reverse_proxy frontend:80
    }
}